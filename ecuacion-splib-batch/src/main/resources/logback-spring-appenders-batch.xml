<!DOCTYPE xml>
<included>

	<!--
		Each job runs as its own JVM process (one job per invocation), so job-name is fixed for
		the life of the process. Setting detail-filename-postfix before the include below makes
		logback-spring-appenders.xml's own detail-appender pick it up via its "${...:-detail}"
		default, instead of a second competing definition of the same appender.
		logfile-path/archivefile-path themselves are left untouched since summary-appender below
		shares them and must not pick up job-name too.

		The detail log file name is "<project-name>-detail-<job-name>.log" ("detail" first, so that
		the log type stays recognizable whatever the job name is), or "<project-name>-detail.log"
		when spring.batch.job.name is not set. The latter is the normal case for an app with only
		one job, since Spring Boot then runs that single job without the property.

		Logback has no conditional without janino, so the empty / non-empty branch is done with a
		nested variable name and a default value:
		  - job-name is empty: "${detail-postfix-of-${job-name}}" becomes "${detail-postfix-of-}",
		    which is defined below as "detail".
		  - job-name is "jobA": "${detail-postfix-of-jobA}" is not defined, so the default value
		    after ":-" is used, which is "detail-jobA".
		Do not define any other property whose name starts with "detail-postfix-of-", or a job with
		the matching name would get that value instead.
	 -->
	<springProperty scope="context" name="job-name" source="spring.batch.job.name" defaultValue="" />
	<property name="detail-postfix-of-" value="detail" />
	<property name="detail-filename-postfix" value="${detail-postfix-of-${job-name}:-detail-${job-name}}" />

	<include resource="logback-spring-appenders.xml" />

	<!-- File output for summary-log -->
	<appender name="summary-appender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!-- File name -->
		<file>${logfile-path}-summary.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!-- File naming pattern for rotation -->
			<fileNamePattern>${archivefile-path}-summary-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
			<maxFileSize>10MB</maxFileSize>
		</rollingPolicy>
		
		<encoder>
			<charset>UTF-8</charset>
			<pattern>${FILE_LOG_PATTERN}</pattern>
		</encoder>
	</appender>
	
</included>
