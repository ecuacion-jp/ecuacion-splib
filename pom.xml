<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>jp.ecuacion.splib</groupId>
	<artifactId>ecuacion-splib-parent</artifactId>
	<packaging>pom</packaging>
	<!-- Using 0.0.2-SNAPSHOT instead of 0.0.1-SNAPSHOT to avoid a DuplicationOfParentVersion IDE warning:
	     0.0.1-SNAPSHOT matches the version of the parent POM (ecuacion-lib-parent:0.0.1-SNAPSHOT). -->
	<version>0.0.2-SNAPSHOT</version>
	<name>${project.artifactId}</name>
	<description>Spring Boot 4 based shared libraries for business application development.</description>
	<url>https://github.com/ecuacion-jp/ecuacion-splib</url>
	<scm>
		<connection>scm:git:https://github.com/ecuacion-jp/ecuacion-splib.git</connection>
		<developerConnection>scm:git:https://github.com/ecuacion-jp/ecuacion-splib.git</developerConnection>
		<url>https://github.com/ecuacion-jp/ecuacion-splib</url>
	</scm>
	<parent>
		<groupId>jp.ecuacion.lib</groupId>
		<artifactId>ecuacion-lib-parent</artifactId>
		<!-- The version number is updated to the latest release in the build script. -->
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	
	<properties>
		<ecuacion-splib.version>0.0.2-SNAPSHOT</ecuacion-splib.version>
		<ecuacion-lib.version>0.0.1-SNAPSHOT</ecuacion-lib.version>
		<ecuacion-util.version>0.0.2-SNAPSHOT</ecuacion-util.version>
		<!-- 3rd party module versions -->
		<spring-boot.version>4.0.7</spring-boot.version>
		<!-- Spring Cloud release train compatible with spring-boot.version above (per the
		     spring.io Spring Boot / Spring Cloud compatibility matrix). Only spring-cloud-context
		     (an optional dependency of ecuacion-splib-core; see its pom.xml) needs a managed
		     version, but importing the full BOM keeps that version aligned with spring-boot.version
		     instead of hand-pinning a single artifact version that could drift out of sync. -->
		<spring-cloud.version>2025.1.1</spring-cloud.version>
		<!-- Delimiter used for build-time property filtering of application*.{yml,yaml,properties}
		     below (e.g. "@project.version@"). Using "@" instead of Maven's default "${...}" avoids
		     colliding with Spring's own runtime "${...}" placeholders (env var substitution etc.)
		     in those same files. Matches spring-boot-starter-parent's own convention/property name. -->
		<resource.delimiter>@</resource.delimiter>
	</properties>

	<build>

		<!-- Filters application*.{yml,yaml,properties} at build time using "@..@" delimiters
		     (see maven-resources-plugin pluginManagement below), while every other resource is
		     copied through unfiltered. Mirrors spring-boot-starter-parent's own <resources>
		     split exactly, so apps built on splib get the same "@project.version@"-in-
		     application.properties convenience they'd get from using Spring Boot's own parent
		     POM, something dependencyManagement/BOM import can never provide, since only an
		     actual Maven <parent> propagates <build><resources>. -->
		<resources>
			<resource>
				<directory>${basedir}/src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/application*.yml</include>
					<include>**/application*.yaml</include>
					<include>**/application*.properties</include>
				</includes>
			</resource>
			<resource>
				<directory>${basedir}/src/main/resources</directory>
				<excludes>
					<exclude>**/application*.yml</exclude>
					<exclude>**/application*.yaml</exclude>
					<exclude>**/application*.properties</exclude>
				</excludes>
			</resource>
		</resources>

		<pluginManagement>
			<plugins>

				<!-- maven-resources-plugin: switch the filtering delimiter from Maven's default
				     "${...}" to "@..@" (see resource.delimiter property above), so the <resources>
				     filtering declared above doesn't misinterpret Spring's own "${...}" runtime
				     placeholders inside application.yml/properties. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<configuration>
						<propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
						<delimiters>
							<delimiter>${resource.delimiter}</delimiter>
						</delimiters>
						<useDefaultDelimiters>false</useDefaultDelimiters>
					</configuration>
				</plugin>

				<!-- spring-boot-maven-plugin: repackages jar into executable fat jar -->
				<!-- Used only by batch / standalone Spring Boot modules -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring-boot.version}</version>
					<executions>
						<execution>
							<goals>
								<goal>repackage</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- maven-compiler-plugin: -parameters / -Xlint.
				       - -parameters: required by Spring 6+ for @RequestParam / @PathVariable
				         parameter name resolution. This affects bytecode your own controller
				         classes need, not just splib's.
				       - -Xlint:-requires-transitive-automatic: silences a compiler warning
				         triggered by JPMS automatic modules that Spring Boot dependencies
				         expose transitively. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<compilerArgs>
							<arg>-parameters</arg>
							<arg>-Xlint:-requires-transitive-automatic</arg>
						</compilerArgs>
					</configuration>
				</plugin>

				<!-- maven-surefire-plugin: useModulePath=false for Spring Boot + JPMS -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${org.apache.maven.plugins.maven-surefire-plugin.version}</version>
					<configuration>
						<!-- Disable module path: module-info.java in main sources causes surefire
						     to run in module mode, but Spring Boot dependencies do not fully
						     support JPMS. Using classpath mode avoids module resolution errors. -->
						<useModulePath>false</useModulePath>
					</configuration>
				</plugin>

			</plugins>
		</pluginManagement>

	</build>

	<!-- No <dependencies> block here on purpose: using this as your parent POM must not add
	     spring-boot-devtools / spring-boot-starter-test / allure-jupiter to your project. -->

	<dependencyManagement>
		<dependencies>

			<!-- spring-boot-dependencies -->
			<dependency>
				<type>pom</type>
				<scope>import</scope>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>

			<!-- spring-cloud-dependencies: see spring-cloud.version property above -->
			<dependency>
				<type>pom</type>
				<scope>import</scope>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
			</dependency>

			<!-- ecuacion-util-import -->
			<dependency>
				<type>pom</type>
				<scope>import</scope>
				<groupId>jp.ecuacion.util</groupId>
				<artifactId>ecuacion-util-parent</artifactId>
				<version>${ecuacion-util.version}</version>
			</dependency>

			<!-- ecuacion-splib -->
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-core</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-jpa</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-batch</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-ui</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-cli</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-rest</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-web</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-web-jpa</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.splib</groupId>
				<artifactId>ecuacion-splib-web-markdown</artifactId>
				<version>${ecuacion-splib.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<profiles>
		<!-- ecuacion-repository profile is also used for builds, but fully inherited from ecuacion-lib, so no definition here. -->
		<profile>
			<id>maven-central</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<configuration>
							<deploymentName>ecuacion-splib-${project.version}</deploymentName>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<modules>
		<module>ecuacion-splib-dependencies</module>
		<module>ecuacion-splib-core</module>
		<module>ecuacion-splib-jpa</module>
		<module>ecuacion-splib-batch</module>
		<module>ecuacion-splib-ui</module>
		<module>ecuacion-splib-cli</module>
		<module>ecuacion-splib-web</module>
		<module>ecuacion-splib-web-jpa</module>
		<module>ecuacion-splib-web-markdown</module>
		<module>ecuacion-splib-rest</module>
	</modules>

</project>
