<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ecuacion-splib-core</artifactId>
	<name>${project.artifactId}</name>
	<packaging>jar</packaging>
	<parent>
		<groupId>jp.ecuacion.splib</groupId>
		<artifactId>ecuacion-splib-dependencies</artifactId>
		<version>0.0.2-SNAPSHOT</version>
		<relativePath>../ecuacion-splib-dependencies</relativePath>
	</parent>

	<dependencies>

		<!-- spring boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- spring security: only for BCryptPasswordEncoder, used by SplibHashedPropertyResolver -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Tomcat (Catalina) API: only for SplibAppConfDirLifecycleListener, a Tomcat
			LifecycleListener a consuming app's own META-INF/context.xml can reference when
			deployed to an existing Tomcat. provided (not optional=true, unlike spring-cloud-context
			above): unlike that case, this really is "supplied by the runtime container," not an
			opt-in enhancement — Catalina classes are on the classpath either via Tomcat's own
			runtime (external-Tomcat deployment) or via the consuming app's own
			spring-boot-starter-tomcat (executable WAR), never bundled here. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- spring-cloud-context: optional. When a consuming app adds this dependency itself,
			SplibPropertiesCacheClearer additionally refreshes Spring's own properties cache
			(via ContextRefresher) when clearing PropertiesFileUtil's cache; otherwise that part
			is skipped at runtime (see SplibPropertiesCacheClearer). optional=true keeps it from
			being pulled onto consuming apps' classpaths transitively. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-context</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ecuacion-lib -->
		<dependency>
			<groupId>jp.ecuacion.lib</groupId>
			<artifactId>ecuacion-lib-validation</artifactId>
		</dependency>

	</dependencies>

	<build>
		<resources>
			<!-- version_ecuacion-splib.properties: @project.version@ is replaced with the build version. -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>version_ecuacion-splib.properties</include>
				</includes>
			</resource>
			<!-- All other resources (messages_xxx.properties, logback-xxx.xml etc. use ${...} for EL
				expressions or logback properties, so they must not go through filtering). -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>version_ecuacion-splib.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<configuration>
					<!-- Use @xxx@ instead of the default ${xxx} to avoid conflicting with
						the ${...} EL expression syntax used in ecuacion-splib properties files. -->
					<useDefaultDelimiters>false</useDefaultDelimiters>
					<delimiters>
						<delimiter>@</delimiter>
					</delimiters>
					<propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
