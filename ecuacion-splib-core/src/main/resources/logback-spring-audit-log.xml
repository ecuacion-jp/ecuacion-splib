<!DOCTYPE xml>
<included>

	<!--
		Audit log (jp.ecuacion.splib.core.audit), written by AuditLogWriter to the
		"audit-logger" logger. Include this file after logback-spring-appenders.xml (it uses
		logfile-path / archivefile-path defined there) when jp.ecuacion.splib.core.audit-log.enabled
		is true. Not part of logback-spring-appenders.xml, since a file appender creates its file at
		startup even when nothing is ever written to it - every application, including batch ones,
		would get an empty audit log file.

		Each line is one JSON object as is (%msg only: the record holds its own timestamp), so that
		the file can be read by log collectors without parsing a prefix.

		Without this file, audit-logger has no appender of its own and records go to wherever the
		root logger goes (e.g. the console in local environments), if the root level is INFO or
		finer. AuditLogWriter warns at startup when audit-logger is not enabled at INFO.
	 -->
	<appender name="audit-appender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!-- File name -->
		<file>${logfile-path}-audit.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!-- File naming pattern for rotation -->
			<fileNamePattern>${archivefile-path}-audit-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
			<maxFileSize>10MB</maxFileSize>
		</rollingPolicy>

		<encoder>
			<charset>UTF-8</charset>
			<pattern>%msg%n</pattern>
		</encoder>
	</appender>

	<!-- additivity="false": audit records go to the audit log only, not also to the detail log -->
	<logger name="audit-logger" level="INFO" additivity="false">
		<appender-ref ref="audit-appender" />
	</logger>

</included>
